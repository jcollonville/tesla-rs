# Copy to server/.env and fill in the secrets. Do not commit .env.

TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_FLEET_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_DOMAIN=tsl.b-612.fr
TESLA_PUBLIC_BASE_URL=https://tsl.b-612.fr
DATABASE_URL=postgres://tesla_logger:change-me@postgres:5432/tesla_logger
TESLA_PRIVATE_KEY_PATH=/keys/private-key.pem
TESLA_TOKEN_STORE_PATH=/data/tokens.json
TESLA_TOKEN_ENCRYPTION_KEY=
TESLA_LISTEN_ADDR=0.0.0.0:4000
TESLA_LOGGER_UI_PASSWORD=

# Poll intervals in seconds. Live vehicle_data is used only while the car is already online.
POLL_DRIVE_SECS=15
POLL_CHARGE_SECS=60
POLL_PARKED_SECS=180
POLL_ASLEEP_SECS=300
POLL_BACKOFF_SECS=720
POLL_PARKED_LIVE_LIMIT=2

NOMINATIM_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=
NOMINATIM_MIN_INTERVAL_MS=1100

MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tesla_logger

# Optional Fleet Telemetry receiver. Leave disabled for the polling MVP.
TELEMETRY_ENABLED=false
TELEMETRY_BIND=0.0.0.0:4443
TELEMETRY_CERT_PATH=
TELEMETRY_KEY_PATH=

# Used by docker compose for the Postgres role. Keep it in sync with DATABASE_URL.
POSTGRES_PASSWORD=change-me
