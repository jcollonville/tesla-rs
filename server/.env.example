# Copy to server/.env and fill in the secrets. Do not commit .env.

TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_FLEET_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_DOMAIN=tsl.b-612.fr
TESLA_PUBLIC_BASE_URL=https://tsl.b-612.fr
DATABASE_URL=postgres://tesla_logger:change-me@postgres:5432/tesla_logger
TESLA_PRIVATE_KEY_PATH=/keys/private-key.pem
TESLA_TOKEN_STORE_PATH=/data/tokens.json
TESLA_TOKEN_ENCRYPTION_KEY=
TESLA_LISTEN_ADDR=0.0.0.0:4000
TESLA_LOGGER_UI_PASSWORD=

# Stats charts. Buckets use this IANA zone (Monday-start ISO weeks).
TESLA_TIMEZONE=Europe/Paris
# Optional currency per kWh when a charge has no stored cost.
# ENERGY_PRICE_PER_KWH=0.25

# Poll intervals in seconds. Live vehicle_data is used only while the car is already online.
# A healthy Owner stream (connected, data:update younger than 90s) does not poll
# vehicle_data during a drive. This is the interval when that stream is down or stale.
POLL_DRIVE_FALLBACK_SECS=120
POLL_CHARGE_SECS=300
POLL_PARKED_SECS=180
POLL_ASLEEP_SECS=300
POLL_BACKOFF_SECS=720
POLL_PARKED_LIVE_LIMIT=2
# Minimum gap between source=poll drive positions when the Owner stream is down or stale.
POLL_GPS_FALLBACK_SECS=300
# vehicle_data calls per UTC day and UTC month. 408 and other 4xx count. 0 blocks the endpoint.
FLEET_DATA_DAILY_CAP=150
FLEET_DATA_MONTHLY_CAP=4500
# How often to probe after Tesla answers 402 or 403 EXCEEDED_LIMIT. 300–86400.
FLEET_BLOCKED_PROBE_SECS=3600
# DRIVE_PARK_GRACE_SECS is how long speed must stay at exact 0 km/h before a drive closes.
# DRIVE_END_GRACE_SECS is the signal-loss wait when that tail has no 0 km/h sample.
# Neither delay is subtracted from the trip: end_at is the first 0 km/h sample of the final run.
# DRIVE_END_GRACE_SECS=300
# DRIVE_PARK_GRACE_SECS=300

NOMINATIM_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=
NOMINATIM_MIN_INTERVAL_MS=1100

# Official Tesla car pictures, fetched once by the server (no VIN) and cached under /data/car-renders.
# Set to false to keep the drawn silhouettes and make no request to Tesla's image host.
CAR_RENDERS_ENABLED=true

# Basemap for drive and charge pages. The server fetches and caches tiles; the
# browser never contacts the tile host. `off` keeps the drawn track only.
# TILE_UPSTREAM=https://tiles.openfreemap.org

MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tesla_logger

# Optional Owner API streaming for dense drive positions. Unofficial legacy API.
# Leave unset to allow it. The token is saved from the status page, not from here.
OWNER_STREAM_ENABLED=true
# TESLA_OWNER_TOKEN_STORE_PATH=/data/owner-tokens.json

# Optional Fleet Telemetry receiver. Leave disabled for the polling MVP.
TELEMETRY_ENABLED=false
TELEMETRY_BIND=0.0.0.0:4443
TELEMETRY_CERT_PATH=
TELEMETRY_KEY_PATH=

# Used by docker compose for the Postgres role. Keep it in sync with DATABASE_URL.
POSTGRES_PASSWORD=change-me
