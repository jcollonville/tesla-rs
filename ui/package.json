  },
  "scripts": {
    "build": "vite build && cp src/index.d.ts dist/index.d.ts && cp src/tokens.css dist/tokens.css",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=20"
  }
}
