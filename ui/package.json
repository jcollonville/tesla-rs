{
  "name": "@jcollonville/tesla-logger-ui",
  "version": "0.1.0",
  "description": "Shared Tesla Logger console components for the web console and the Home Assistant card",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "module": "./dist/tesla-logger-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
